    {
      "id": "snowluma-dsh",
      "name": "SnowLuma + qq-bridge + DeepSeek Harness",
      "tagline": "本市场原生链路：协议端登录一次，后面插件即插即用",
      "primary": true,
      "primaryNote": "站内主推，也是大部分人现在用的那条：空间动态、语音调音、表情包、群管理这些能力都按它调好的接口写的，接入一次就能用；识图和认视频只调模型接口，开不开协议端都能用。其他路线照常支持，只是这几项要先确认协议端也在讲 OneBot v11",
      "account": "personal",
      "accountNote": "SnowLuma 走个人号协议，务必用小号",
      "os": [
        "windows"
      ],
      "needsDesktopQQ": false,
      "qqnt": {
        "required": false,
        "note": "SnowLuma 不需要安装桌面 QQ"
      },
      "runtime": {
        "node": ">=20",
        "python": null,
        "docker": false
      },
      "stack": [
        "SnowLuma",
        "qq-bridge",
        "DeepSeek Harness",
        "DeepSeek API"
      ],
      "protocols": [
        "onebot11"
      ],
      "host": "dsh",
      "pluginApi": "mcp-dsh",
      "ports": [
        {
          "port": 3000,
          "role": "OneBot v11 HTTP"
        },
        {
          "port": 3001,
          "role": "OneBot v11 WebSocket"
        },
        {
          "port": 3100,
          "role": "qq-bridge 控制台"
        },
        {
          "port": 0,
          "role": "DeepSeek Harness（端口动态，自动探测）"
        }
      ],
      "keyConfig": [
        {
          "key": "onebotToken",
          "label": "OneBot AccessToken",
          "secret": true,
          "required": false,
          "help": "SnowLuma 面板里设的 token；填了市场才能调它的接口"
        },
        {
          "key": "dshToken",
          "label": "DSH API Key",
          "secret": true,
          "required": false,
          "help": "可选，接 DSH 的 OpenAI 兼容口时才需要"
        }
      ],
      "deploy": {
        "level": "oneclick",
        "kind": "script",
        "chain": [
          "node",
          "snowluma",
          "qqbridge",
          "dsh",
          "market"
        ],
        "recipe": "snowluma",
        "verified": true,
        "verifiedNote": "2026-10-28 16:20 本机实测：node/snowluma/qqbridge/dsh 四步全 done，QQ 3996086451 在线，DSH 自动识别端口 11762",
        "manualSteps": [
          "SnowLuma 安装包需手动下载解压到 C:\\SnowLuma（它没有自动安装器）",
          "首次扫码登录 QQ"
        ],
        "requirements": [
          "Node.js 18+"
        ]
      },
      "risks": [
        "个人号协议，腾讯风控会封号：只用小号，不要用主号",
        "同 IP 多开、频繁加群/发消息会显著提高风控概率"
      ],
